{
  "name": "devtools-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Try WebdriverIO DevTools on a small app with planted bugs, in live mode and trace mode.",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "scripts": {
    "app": "node app/server.mjs",
    "demo": "wdio run wdio.conf.ts",
    "demo:trace": "wdio run wdio.trace.conf.ts",
    "show-trace": "show-trace"
  },
  "devDependencies": {
    "@wdio/cli": "10.1.0",
    "@wdio/devtools-service": "11.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "webdriverio": "10.1.0"
  }
}
